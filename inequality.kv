<InequalityApp>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

<Label>:
    color: 0, 0, 0, 1
    font_size: '16sp'

<TextInput>:
    background_color: 1, 1, 1, 1
    foreground_color: 0, 0, 0, 1
    font_size: '14sp'
    padding: [8, 8]

<Button>:
    background_color: 0.2, 0.6, 0.8, 1
    color: 1, 1, 1, 1
    font_size: '18sp'

<Spinner>:
    background_color: 0.8, 0.8, 0.8, 1
    color: 0, 0, 0, 1
    font_size: '14sp'